DATABASE_URL=postgresql://konga:konga@localhost:5433/konga

# Generate unique values (do not commit real secrets):
#   openssl rand -base64 48
#   openssl rand -hex 32
NUXT_SESSION_PASSWORD=<generate-at-least-32-random-chars>
NODE_CREDENTIALS_KEY=<generate-64-hex-chars-or-long-random-string>

# true when serving over HTTPS; false for local http://
COOKIE_SECURE=false

# Allow Kong Admin URLs that resolve to private IPs (Docker/LAN). Required for typical local Kong.
# Set to false in internet-facing deployments unless Kong Admin is intentionally private.
KONGA_ALLOW_PRIVATE_ADMIN_URL=true

# Optional: first-boot admin (only used when the user table is empty)
# KONGA_ADMIN_USERNAME=admin
# KONGA_ADMIN_EMAIL=admin@konga.local
# KONGA_ADMIN_PASSWORD=  # if unset, a random password is generated and printed to logs once

HOST=0.0.0.0
PORT=1337
NODE_ENV=development
